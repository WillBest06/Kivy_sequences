#:kivy 2.3.1

ScreenManager:
    StartScreen:
        name: "start"
    GameScreen:
        name: "game"
    VictoryScreen:
        name: "victory"

# ----------------- SCREEN 1: START SCREEN -----------------
<StartScreen>:
    # Add a pastel yellow background
    canvas.before:
        Color:
            rgba: 1, 0.98, 0.8, 1  
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: 50
        spacing: 20

        Label:
            text: "Sequence Master"
            font_size: "48sp"
            bold: True
            color: 0, 0, 0, 1  # Black text
            size_hint_y: 0.4

        Label:
            text: "Rules:\n1. Click the items in the correct order.\n2. Do it as fast as you can!\n3. Beat all levels to win.\n4. Lower scores are better."
            font_size: "24sp"
            color: 0, 0, 0, 1
            halign: "center"
            size_hint_y: 0.4

        Button:
            text: "Begin Game"
            font_size: "32sp"
            size_hint_y: 0.2
            background_color: 0, 1, 0, 1
            on_press: app.start_game()

# ----------------- SCREEN 2: GAME SCREEN -----------------
<GameScreen>:
    # Add a pastel blue background
    canvas.before:
        Color:
            rgba: 0.85, 0.93, 1, 1 
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 20

        HeaderWidget:
            size_hint_y: 0.2

        ContentWidget:
            id: content_area
            size_hint_y: 0.6

        FooterWidget:
            size_hint_y: 0.2


# ----------------- SCREEN 3: VICTORY SCREEN -----------------
<VictoryScreen>:
    # Add a pastel green background
    canvas.before:
        Color:
            rgba: 0.88, 1, 0.88, 1  
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: 50
        spacing: 20

        Label:
            text: "YOU WIN!"
            font_size: "48sp"
            color: 0, 0.6, 0, 1  # Dark Green text
            bold: True
            size_hint_y: 0.2
            
        BoxLayout:
            size_hint_y: 0.6

            BoxLayout:
                id: challenge_times
                orientation: "vertical"
                size_hint_x: 0.5

            BoxLayout:
                id: victory_stats
                orientation: "vertical"
                size_hint_x: 0.5

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: 0.2 
            spacing: 20

            Button:
                text: "Play Again"
                font_size: "32sp"
                size_hint_x: 0.5
                background_color: 0, 1, 0, 1
                on_press: app.reset_game()
            
            Button:
                text: "Quit"
                font_size: "32sp"
                size_hint_x: 0.5
                background_color: 1, 0, 0, 1
                on_press: app.stop() 


# ----------------- MODULAR GAME WIDGETS -----------------
<HeaderWidget>:
    orientation: "horizontal"
    spacing: 10

    ProgressBar:
        size_hint_x: 0.25
        max: 100
        value: app.progress_value

    Label:
        size_hint_x: 0.25
        text: app.level_text
        color: 0, 0, 0, 1
        font_size: "20sp"

    Label:
        size_hint_x: 0.25
        text: app.stopwatch_text
        color: 0, 0, 0, 1
        font_size: "24sp"


<ContentWidget>:
    orientation: "vertical"
    spacing: 20

    Label:
        text: app.status_text
        color: 0, 0, 0, 1
        font_size: "32sp"
        halign: "center"
        size_hint_y: 0.3

    BoxLayout:
        id: sequence_row
        orientation: "horizontal"
        size_hint_y: 0.7
        spacing: 20
        padding: [20, 0, 20, 0]


<SequenceItem>:
    padding: 10
    Button:
        text: root.val
        font_size: "32sp"
        on_press: app.check_answer(root.val, root)


<FooterWidget>:
    orientation: "horizontal"

    Button:
        text: app.toggle_text  
        font_size: "24sp"
        # Calls the new traffic-cop function instead of toggling the stopwatch directly
        on_press: app.handle_footer_button()